<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Tourismfrontend" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- Define primary color to replace the purple -->
        <item name="colorPrimary">@color/teal_700</item> <!-- Replace purple -->
        <item name="colorPrimaryVariant">@color/teal_700</item> <!-- Replace purple variant -->
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <style name="Theme.Tourismfrontend" parent="Base.Theme.Tourismfrontend" />

    <!-- Specific theme for Tourism -->
    <style name="Theme.Tourism" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/teal_700</item> <!-- Replace purple -->
        <item name="colorPrimaryVariant">@color/teal_700</item> <!-- Replace purple variant -->
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/teal_700</item> <!-- Match toolbar -->
        <item name="android:windowLightStatusBar">false</item> <!-- Set to false for white text/icons -->
    </style>
</resources>
